# ===========================================================================
# UI State
#
# THIS is the single correct location for every setEnabled(), setVisible(),
# and setChecked() call that depends on what is selected in the tree.
#
# Why one function, called once, at the end of the slot?
# -------------------------------------------------------
# Each handler above only sees its own bucket (e.g. residues).  A button
# whose enabled state depends on a *combination* of buckets — e.g. "Align to
# sequence" which requires both sequences AND residues — cannot be correctly
# decided inside either handler alone.  By the time _update_ui_state runs,
# the full SelectionResult is available and every condition can be evaluated
# in one readable place.
#
# It also prevents a subtle bug: if handler A enables a button and handler B
# is not called (its bucket is empty), the button stays enabled from a
# previous selection.  _update_ui_state resets everything unconditionally on
# every call, so there is never any stale state left over from a prior
# selection.
#
# Structure inside _update_ui_state:
# -----------------------------------
# Group the calls by UI area (toolbar, detail panels, status bar, …) rather
# than by selection type.  This makes it easy to see at a glance what every
# button/panel does in the full selection space without jumping between
# handler functions.
# ===========================================================================

def _update_ui_state(self, result: SelectionResult) -> None:
    """Apply enabled/visible/checked state to every context-sensitive UI element.

    Called exactly once per selection change, after all content handlers have
    run, with the complete ``SelectionResult``.

    Args:
        result: The fully classified current selection.  Use ``result.is_empty``
                to detect an empty selection (clears / deselects).

    Structure
    ---------
    Add one block per logical UI area.  Within each block, set *every*
    element unconditionally — never skip an element because you think it is
    already in the right state.  This guarantees no stale state survives
    across selection changes.

    All conditions are written purely in terms of ``result``.  Do not
    access ``self._tree_view`` or any model here; all necessary information
    was already extracted during classification and is available on the
    result object.
    """

    # ------------------------------------------------------------------
    # Toolbar / action buttons — sequence domain
    #
    # Add here:
    #   self.btn_delete_sequence.setEnabled(result.has_sequences)
    #   self.btn_export_fasta.setEnabled(result.has_sequences)
    #   self.btn_copy_sequence.setEnabled(result.has_sequences)
    #   self.btn_align_two_sequences.setEnabled(len(result.sequences) == 2)
    #   self.btn_multi_align.setEnabled(len(result.sequences) > 2)
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # Toolbar / action buttons — protein domain
    #
    # Add here:
    #   self.btn_delete_protein.setEnabled(result.has_proteins)
    #   self.btn_rename_protein.setEnabled(len(result.standalone_proteins) == 1)
    #   self.btn_export_pdb.setEnabled(result.has_proteins)
    #   self.btn_create_pair.setEnabled(len(result.standalone_proteins) == 2)
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # Toolbar / action buttons — protein pair domain
    #
    # Add here:
    #   self.btn_delete_pair.setEnabled(result.has_protein_pairs)
    #   self.btn_run_analysis.setEnabled(len(result.protein_pairs) == 1)
    #   self.btn_export_results.setEnabled(result.has_protein_pairs)
    #   self.btn_bulk_export.setEnabled(len(result.protein_pairs) > 1)
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # Toolbar / action buttons — scene domain
    #
    # Add here:
    #   self.btn_add_scene.setEnabled(bool(result.scenes_headers)
    #                                 and len(result.scenes_headers) == 1)
    #   self.btn_delete_scene.setEnabled(result.has_scenes)
    #   self.btn_rename_scene.setEnabled(len(result.scenes) == 1)
    #   self.btn_export_scene_image.setEnabled(len(result.scenes) == 1)
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # Toolbar / action buttons — sub-structure domain
    # (chains, residues, atoms — often share a toolbar section)
    #
    # Add here:
    #   self.btn_change_chain_colour.setEnabled(result.has_chains)
    #   self.btn_hide_show_chain.setEnabled(result.has_chains)
    #   self.btn_mutate_residue.setEnabled(len(result.residues) == 1)
