    #                                        or (len(result.residues) == 2
    #                                            and len(result.all_selected_protein_names()) == 2))
    #   self.btn_measure_angle.setEnabled(len(result.atoms) == 3)
    #   self.btn_measure_dihedral.setEnabled(len(result.atoms) == 4)
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # Toolbar / action buttons — cross-domain combinations
    # These buttons require items from more than one bucket simultaneously.
    # This is the ONLY place where such conditions can be written correctly.
    #
    # Add here:
    #   self.btn_align_to_structure.setEnabled(
    #       result.has_sequences and result.has_residues
    #   )
    #   self.btn_assign_sequence_to_protein.setEnabled(
    #       result.has_sequences and result.has_proteins
    #   )
    # ------------------------------------------------------------------

    # ------------------------------------------------------------------
    # Detail panels — show/hide based on what is selected
    # Hide all panels first, then show only the relevant one(s).
    # This unconditional reset is what prevents stale visibility state.
    #
    # Add here:
