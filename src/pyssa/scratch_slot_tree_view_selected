    #   self.scene_thumbnail_panel.setVisible(len(result.scenes) == 1)
    #   self.residue_properties_panel.setVisible(len(result.residues) == 1)
    #   self.residue_list_panel.setVisible(len(result.residues) > 1)
    #   self.atom_properties_panel.setVisible(len(result.atoms) == 1)
    #   self.atom_list_panel.setVisible(len(result.atoms) > 1)
    #   self.colour_picker_panel.setVisible(len(result.chains) == 1)
